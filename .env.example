# PostgreSQL connection string (required). Create the tables and sample data with: npm run db:setup
# Local:  postgres://postgres:yourpassword@localhost:5432/pangisda
# Hosted (Neon, Supabase, Render): paste the URL they give you, usually ending in ?sslmode=require
DATABASE_URL=postgres://postgres:yourpassword@localhost:5432/pangisda

# Secret used to sign login tokens (JWT). Required in production; use a long random string.
JWT_SECRET=change-me-to-a-long-random-string

